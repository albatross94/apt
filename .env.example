SERVICE_KEY=your_data_go_kr_service_key

# 로그인 비밀번호(공용 1개). 비워 두면 로그인 없이 열립니다. 배포할 때는 반드시 설정하세요.
APP_PASSWORD=
VWORLD_KEY=your_vworld_key_optional_for_public_housing_price

# (선택) 지도 카드용 카카오 JavaScript 키. 카카오 개발자 콘솔의 플랫폼(Web)에 사이트 도메인을 등록해야 합니다.
KAKAO_JS_KEY=

# (선택) 전월세 API를 별도 키로 신청했다면 입력. 비워 두면 SERVICE_KEY 사용
RENT_SERVICE_KEY=

# (선택, 빌드 스크립트 전용) 카카오 REST API 키. scripts/build-complex.js 가 동 좌표를 검색할 때만 쓰며 사이트에는 올라가지 않습니다.
KAKAO_REST_API_KEY=

# (선택, 빌드 스크립트 전용) 유치원알리미 Open API 키. scripts/build-kinder.js 가 data/kinder/kinder.json 을 만들 때만 쓰며 사이트에는 올라가지 않습니다.
KINDER_API_KEY=
